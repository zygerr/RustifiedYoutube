{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustifiedYoutube",
  "version": "0.1.2",
  "identifier": "io.github.zygerr.rustifiedyoutube",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Your music. Your desktop.",
    "longDescription": "An unofficial YouTube Music desktop client built with Rust and Tauri. Includes background playback, a system tray, and native playback controls.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "RustifiedYoutube"
      }
    }
  }
}
